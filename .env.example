# Server binding & logging
BIND_ADDR=0.0.0.0:3000
RUST_LOG=urashyl_portfolio=info

# ==============================================================================
# Grafana API Telemetry Configuration
# ==============================================================================
# How to generate an API key (Service Account Token) in Grafana:
#   1. Open Grafana -> Administration -> Users and access -> Service accounts
#   2. Click "Add service account", name it e.g. "urashyl-portfolio", Role: "Viewer"
#   3. Click "Add service account token", copy the `glsa_...` key below
#   4. Copy this file to `.env` (already gitignored) and fill in your URL + token
# ==============================================================================

GRAFANA_URL=https://grafana.urashyl.dev
GRAFANA_API_KEY=glsa_your_service_account_token_here

# Optional public URL & dashboard linking
# Leave GRAFANA_PUBLIC_URL unset and GRAFANA_EXPOSE_LINKS=false to keep your
# internal Grafana URL private while still displaying sanitized metrics.
# GRAFANA_PUBLIC_URL=https://grafana.urashyl.dev
GRAFANA_EXPOSE_LINKS=false

# Optional Grafana organization & datasource selection
# GRAFANA_ORG_ID=1
# GRAFANA_DATASOURCE_UID=
# Supported types: "prometheus" (includes VictoriaMetrics) or "influxdb"
# GRAFANA_DATASOURCE_TYPE=prometheus
# GRAFANA_DASHBOARD_TAG=homelab

# Polling & query window settings
# Valid GRAFANA_TIME_RANGE values: 1h, 3h, 6h, 12h, 24h, 7d
GRAFANA_POLL_INTERVAL_SECS=30
GRAFANA_TIMEOUT_SECS=8
GRAFANA_TIME_RANGE=6h
# Set true only if Grafana uses an internal self-signed TLS certificate
GRAFANA_INSECURE_TLS=false

# Optional custom metric queries. Prometheus defaults auto-detect both Proxmox
# `prometheus-pve-exporter` (`pve_*`) and Linux `node_exporter` (`node_*`).
# InfluxQL defaults are used when GRAFANA_DATASOURCE_TYPE=influxdb.
# Uncomment any override below:
# GRAFANA_QUERY_CPU=
# GRAFANA_QUERY_MEMORY=
# GRAFANA_QUERY_DISK=
# GRAFANA_QUERY_LOAD=
# GRAFANA_QUERY_GUESTS=
# GRAFANA_QUERY_UPTIME=
# GRAFANA_QUERY_NETWORK=
# GRAFANA_QUERY_SERVICES=
